{
  "name": "overdrive-optimizer",
  "version": "0.2.0",
  "description": "Optimizador de PC para gaming: analiza hardware/software, detecta drivers desactualizados y aplica optimizaciones reversibles con punto de restauracion.",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "dist": "electron-builder",
    "dist:dir": "electron-builder --dir",
    "release": "electron-builder --publish always"
  },
  "build": {
    "appId": "com.albertomontero.overdrive",
    "productName": "Overdrive",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "monteero13",
        "repo": "overdrive-optimizer",
        "releaseType": "release"
      }
    ],
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Overdrive",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Overdrive-${version}-portable.exe"
    }
  },
  "keywords": [
    "gaming",
    "optimizer",
    "windows",
    "electron",
    "performance"
  ],
  "author": "Alberto Montero",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
