{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Overdrive",
  "version": "1.0.0-alpha.2",
  "identifier": "app.overdrive.optimizer",
  "build": {
    "frontendDist": "../web/dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Overdrive",
    "shortDescription": "Optimizaciones de juego medidas y reversibles",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../../target/release/overdrive-svc.exe": "overdrive-svc.exe",
      "../../tools/presentmon/PresentMon.exe": "presentmon/PresentMon.exe"
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "./installer-hooks.nsh",
        "languages": [
          "Spanish",
          "English"
        ],
        "displayLanguageSelector": false
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQwRUU1MzlBQjI0NTlBMkEKUldRcW1rV3ltbFB1UUcveXZYNUpYOFB6Q0piZEErRUlQWEt2d3RGY2oxdjlqL0xHQ3lhTTRJYWIK",
      "endpoints": [
        "https://github.com/monteero13/overdrive-optimizer/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
